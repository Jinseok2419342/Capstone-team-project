[Unit]
Description=Re:Found lost-item vision service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@@SERVICE_USER@@
Group=@@SERVICE_GROUP@@
WorkingDirectory=/opt/refound
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/refound/runtime.env
ExecStart=/opt/refound/.venv/bin/python /opt/refound/run.py
Restart=on-failure
RestartSec=5s
# Allow the default Pi queue (four jobs, up to two remote attempts each) to drain.
TimeoutStopSec=300s
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
