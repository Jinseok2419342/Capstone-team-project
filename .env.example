# 서버: 기본은 로컬 전용. Pi에서는 SSH 터널/Tailscale Serve로 접속합니다.
HOST=127.0.0.1
PORT=8000
RELOAD=false

# Raspberry Pi에서만 사용: Picamera2와 저부하 기본값을 활성화합니다.
# HARDWARE_PROFILE=raspberry-pi
# CLASSIFIER_WORKERS=1
# CLASSIFICATION_SLOTS=4
# REFERENCE_CACHE_MAX_MB=32

# 멀티모달 AI: 둘 중 하나만 설정해도 됩니다. 둘 다 있으면 OpenAI를 우선 사용합니다.
OPENAI_API_KEY=
GEMINI_API_KEY=

# 메일: Gmail은 일반 비밀번호가 아닌 2단계 인증의 앱 비밀번호를 사용하세요.
# 나머지 SMTP 주소/포트/계정/관리자 메일은 웹의 설정 화면에서 입력합니다.
SMTP_PASSWORD=

# 선택: 저장 위치를 바꾸고 싶을 때만 사용
# DATA_DIR=C:\lost-item-data
# DB_PATH=C:\lost-item-data\lost_items.db
# CAPTURE_DIR=C:\lost-item-data\captures
