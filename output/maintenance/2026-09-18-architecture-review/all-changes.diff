+                                      "reference_jpeg": event.after_jpeg,
+                                      "background_jpeg": event.before_jpeg,
+                                      "tracking_revision": 1})
+            elif event.kind == "removed":
+                with inventory_lock:
+                    inventory.clear()
+                removed.set()
+            return True
+
+        def active():
+            with inventory_lock:
