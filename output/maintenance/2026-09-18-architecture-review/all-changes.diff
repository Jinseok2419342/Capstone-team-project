+    def start_dispatcher(self, monitor, callbacks, diagnostics=None):
+        done = threading.Event()
+        stop = threading.Event()
+        worker = threading.Thread(target=monitor._dispatch_callbacks, args=(callbacks, done, diagnostics, stop))
+        worker.start()
+
+        def cleanup():
